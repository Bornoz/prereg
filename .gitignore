__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/
.venv/
venv/

# Never commit an identity or the local counter that keeps its nonces unique.
identity.pem
state.json
*.pem

# Agent tooling leaves these behind; they do not belong in the history.
CLAUDE.md
AGENTS.md
.claude/
.cursor/
.aider*

# Operational and local-run artifacts. The scheduled agent commits its own
# record/evidence and record/signatures.jsonl from a clean checkout; a local
# run's copies are not the product and must not ride along.
record/first-run.*
record/*.log
record/state.json
